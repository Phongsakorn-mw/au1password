{
  "manifest_version": 3,
  "name": "Au1Password - Zero-Knowledge Password & Passkey Manager",
  "version": "1.0.1",
  "description": "Zero-knowledge password manager, TOTP authenticator, and cloud sync for Linux & browser.",
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "scripting",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://au1password.onrender.com/*",
    "http://127.0.0.1:8765/*",
    "http://localhost:8765/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "popup/*",
        "icons/*",
        "scripts/*"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Au1Password",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["scripts/autofill.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
